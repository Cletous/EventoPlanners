                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const data=pm.response.json();",
                  "if (data.token) pm.environment.set('userToken', data.token);",
                  "pm.test('Token returned', () => pm.expect(data.token).to.be.a('string'));"
                ]
              }
            }
          ]
